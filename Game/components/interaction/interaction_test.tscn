[sub_resource type="GDScript" id="GDScript_demolog"]
script/source = "extends Node
## Demo listener: prints interaction events so the test scene proves the
## EventBus contract by eye (run the scene, walk into a stub, press E).

func _ready() -> void:
	EventBus.interactable_focused.connect(_on_focused)
	EventBus.interactable_unfocused.connect(_on_unfocused)
	EventBus.interaction_requested.connect(_on_requested)

func _on_focused(target: Node) -> void:
	print(\"[demo] focused: \", target.display_name)

func _on_unfocused(target: Node) -> void:
	if is_instance_valid(target):
		print(\"[demo] unfocused: \", target.display_name)

func _on_requested(id: StringName, target: Node) -> void:
	print(\"[demo] interaction_requested id=\", id, \" target=\", target.display_name)
"

