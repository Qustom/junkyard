[internationalization]

locale/translations=PackedStringArray("res://ui/inventory/inventory_strings.en.translation", "res://ui/hud/hud_strings.en.translation", "res://ui/sell/sell_strings.en.translation", "res://ui/config/config_strings.en.translation", "res://scenes/menu/menu_strings.en.translation")

[layer_names]

2d_physics/layer_1="player"
2d_physics/layer_2="world"
2d_physics/layer_3="interactable"
2d_physics/layer_4="enemy"
2d_physics/layer_5="hazard"
2d_physics/layer_6="pawn"

[physics]

; K6 (M1.4): root-cause movement-jitter fix. The player integrates only in
; _physics_process (60 Hz); with interpolation OFF (the Godot 4 default) its
; on-screen transform snaps to the latest physics state every drawn frame, so on
; >60 Hz / browser (itch) displays the body advances in uneven steps the eye reads
; as jitter (amplified by the zoom=2 camera). physics_interpolation=true makes the
; renderer interpolate every physics-moved node between ticks -> smooth at any
; refresh. Render-time only: does NOT change the sim, move_and_slide() results,
; RNG draws, or fingerprint() -> the all-off baseline e943ac9c8bc1 is unaffected.
; ticks_per_second=60 is written explicitly only to make the rate intentional.
common/physics_ticks_per_second=60
common/physics_interpolation=true

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
