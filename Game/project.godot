; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="THE FAR YARD"
config/description="Roguelite extraction + life-sim overworld. Design docs in design/."
run/main_scene="res://scenes/app/app.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://systems/event_bus.gd"
RNG="*res://systems/rng.gd"
GameState="*res://systems/game_state.gd"
SaveManager="*res://systems/save_manager.gd"
AudioDirector="*res://systems/audio_director.gd"
Telemetry="*res://systems/telemetry/telemetry.gd"

[debug]

file_logging/enable_file_logging=true
gdscript/warnings/untyped_declaration=1

[display]

; K3 (M1.4): resolution-independent camera. Render to a fixed base canvas
; (today's implicit 1152x648 engine default, made explicit) and scale that
; canvas to the OS window so the world-units the camera shows no longer track
; the window size. stretch=canvas_items + aspect=expand (no letterbox bars;
; wide windows reveal a wider band) + scale_mode=integer (PIXEL-PERFECT whole-
; number canvas scale, honouring the filter-OFF pixel-art rule). With cam_enabled
; false the CameraView leaves zoom=(2,2) and this base reproduces today's framing.
window/size/viewport_width=1152
window/size/viewport_height=648
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"

[global_group]

socket=""

