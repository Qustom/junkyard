; THE FAR YARD — Godot project file.
; M0 architecture spike (TDD §2): autoload singletons + EventBus + Resource data
; + seeded RNG + save stub. Engine pinned to 4.6.x (see .godot-version).

config_version=5

[application]

config/name="THE FAR YARD"
config/description="Roguelite extraction + life-sim overworld. Design docs in design/."
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

; Order matters: dependency-free services first, then state, then consumers.
EventBus="*res://systems/event_bus.gd"
RNG="*res://systems/rng.gd"
GameState="*res://systems/game_state.gd"
SaveManager="*res://systems/save_manager.gd"
AudioDirector="*res://systems/audio_director.gd"
Telemetry="*res://systems/telemetry.gd"

[debug]

gdscript/warnings/untyped_declaration=1

[input]

; A1 movement actions — names are locked and referenced project-wide.
; Each action binds keyboard + controller so Input.get_vector() yields identical
; results for both. Stick axes carry deadzone=0.2; D-pad/keys are digital.
move_up={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":87,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194320,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventJoypadMotion,"resource_local_to_scene":false,"resource_name":"","device":-1,"axis":1,"axis_value":-1.0,"script":null)
, Object(InputEventJoypadButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"button_index":11,"pressure":0.0,"pressed":false,"script":null)
]
}
move_down={
