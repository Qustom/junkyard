; E3 debug-only failure trigger (key K). With no enemies in M1 "death" needs a
; stand-in: this exercises fail_run(&"death") + the pockets math in tests/demos.
; Timeout is the only PLAYER-FACING failure; debug_kill is for testing, not ship.
debug_kill={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":75,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}

[global_group]

; B1 zone-piece sockets — tagged connection points queried by B2.
socket=""

[layer_names]

; Locked A1 collision layer map (layer = "who I am", mask = "who I detect").
; Reference these names in every task, never raw bit numbers.
2d_physics/layer_1="player"
2d_physics/layer_2="world"
2d_physics/layer_3="interactable"
2d_physics/layer_4="enemy"
2d_physics/layer_5="hazard"
; B1 debug pawn — own layer so it never clashes with the locked 1-5 map.
2d_physics/layer_6="pawn"

[internationalization]

; D2: inventory UI strings are externalized (playbook: "externalize all strings
; for localization"). tr() keys resolve against this CSV-derived translation.
; E2: decision-HUD strings live in ui/hud/hud_strings.csv (same CSV→.translation pipeline).
; F2: sell-screen strings live in ui/sell/sell_strings.csv (same CSV→.translation pipeline).
locale/translations=PackedStringArray("res://ui/inventory/inventory_strings.en.translation", "res://ui/hud/hud_strings.en.translation", "res://ui/sell/sell_strings.en.translation")

[rendering]

renderer/rendering_method="gl_compatibility"
; Pixel-art commitment (TDD §4/§5): nearest-neighbour, filtering OFF.
textures/canvas_textures/default_texture_filter=0
