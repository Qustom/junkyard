.mcp.local.json

# --- Godot 4.x (the engine project now lives under Game/) ---
.godot/
/Game/android/
/Game/build/
/Game/exports/
# legacy root paths (kept harmless in case an old export lingers)
/android/
/build/
/exports/
# G3: export_presets.cfg IS committed (CI references the "Win64" preset by name).
# Our preset carries NO per-machine absolute paths (custom_template empty, export_path
# is the relative build/win/...), so the usual "keep out of VCS" caveat does not apply.
# If anyone adds machine-specific template paths, scrub them before committing.
# export_presets.cfg

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

# --- Test / CI artifacts ---
/Game/reports/
/Game/.gdunit4_testadapter/
/reports/
/.gdunit4_testadapter/

# Generated translation build products (regenerated from .csv on import; see DESIGN_DEVIATIONS_HISTORY D2/repo)
*.translation

# I5 (M1.2): build-SHA stamp artifact, generated by tools/stamp_build.sh and read by
# BuildVersion at runtime. A build product — never committed (a committed copy could go
# stale in source the way the old project.godot config/build_sha did). Its .uid is also
# generated on import and never committed.
/Game/systems/build_info_gen.gd
/Game/systems/build_info_gen.gd.uid

# Agent worktrees (ephemeral; never commit)
.claude/worktrees/

# Local desktop build artifacts (win64 etc.), labeled by build id under builds/<id>/.
# Large binaries produced on demand via the Win64 export preset; never committed.
/builds/
